{
  "expo": {
    "name": "Edo",
    "slug": "edo",
    "version": "0.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android"],
    "plugins": [
      ["expo-localization", { "supportedLocales": ["en", "de"] }],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Edo to read food barcodes using your camera.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-font",
        {
          "ios": { "fonts": ["./assets/fonts/InterVariable.ttf"] },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter 400",
                "fontDefinitions": [{ "path": "./assets/fonts/Inter-Regular.otf", "weight": 400 }]
              },
              {
                "fontFamily": "Inter 500",
                "fontDefinitions": [{ "path": "./assets/fonts/Inter-Medium.otf", "weight": 400 }]
              },
              {
                "fontFamily": "Inter 600",
                "fontDefinitions": [{ "path": "./assets/fonts/Inter-SemiBold.otf", "weight": 400 }]
              },
              {
                "fontFamily": "Inter 700",
                "fontDefinitions": [{ "path": "./assets/fonts/Inter-Bold.otf", "weight": 400 }]
              }
            ]
          }
        }
      ],
      ["expo-asset", { "assets": ["./assets/fonts/inter_license.json"] }]
    ],
    "ios": {
      "bundleIdentifier": "studio.lightwork.edo"
    },
    "android": {
      "package": "studio.lightwork.edo",
      "adaptiveIcon": {
        "backgroundColor": "#141517",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    }
  }
}
